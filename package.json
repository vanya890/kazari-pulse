{
  "name": "kazari-pulse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pulse Drift - a rhythm gate runner for Telegram Mini App",
  "homepage": "https://vanya890.github.io/kazari-pulse/",
  "repository": {
